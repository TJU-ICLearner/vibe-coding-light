{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Coding Light",
  "version": "1.1.0-rc.2",
  "identifier": "com.cuihuapeng.code-light",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "width": 208,
        "height": 208,
        "resizable": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon_32x32.png",
      "icons/icon_128x128.png",
      "icons/icon_128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../hooks/claude/*": "hooks/claude/",
      "../hooks/codex/*": "hooks/codex/",
      "../hooks/integrations/*": "hooks/integrations/"
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
